[Unit]
Description=Seven Blog deployment webhook
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=seven-blog
Group=seven-blog
SupplementaryGroups=docker
WorkingDirectory=/app/caixypromise/seven-blog/service
EnvironmentFile=/app/caixypromise/seven-blog/service/deploy-webhook.env
ExecStart=/usr/bin/webhook -hooks /app/caixypromise/seven-blog/service/hooks.json -ip 127.0.0.1 -port 9178
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
